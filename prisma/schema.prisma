generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName String?
  email String? @unique
  isSubscribedToForecast Boolean? @default(false)
  foreCastSubscription Boolean? @default(false)
  telegramAccount TelegramAccount?
  discordAccount DiscordAccount?

}

model TelegramAccount {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName String?
  userName String
  telegramId String
  isBlocked Boolean @default(false)
  userId String? @unique @db.ObjectId
  user User? @relation(fields: [userId], references: [id])
}

model DiscordAccount {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userName String
  globalName String
  avatar String?
  discordId String
  refreshToken String?
  accessToken String?
  tokenExpiration Int?
  userId String? @unique @db.ObjectId
  user User? @relation(fields: [userId], references: [id])
}


model TgSession{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  key String
  session Json
}
