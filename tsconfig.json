{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,         
    "emitDecoratorMetadata": true           
  },
  "include": ["src/**/*.ts", "index.ts"],
  "exclude": ["node_modules"]
}
